<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override. The main config denies cleartext everywhere, which blocks
  the local development API that debug builds talk to. 10.0.2.2 is the emulator's
  alias for the host loopback.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>