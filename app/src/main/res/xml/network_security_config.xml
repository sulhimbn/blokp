<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Certificate pinning for api.apispreadsheets.com is enforced in code by
      SecurityConfig.getSecureOkHttpClient() (OkHttp CertificatePinner, with the
      same primary + backup pins). A manifest <pin-set> is intentionally omitted:
      the platform parser rejects this file's <pin algorithm> attribute, which
      crashed the app at startup while building the OkHttpClient trust manager.
      Trust anchors and cleartext policy are configured here.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local development hosts stay TLS-only; debug cleartext is allowed below -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">api-mock</domain>
    </domain-config>

    <!-- Debug builds may trust user-installed CAs and use cleartext for local development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
        <cleartextTrafficPermitted>true</cleartextTrafficPermitted>
    </debug-overrides>
</network-security-config>
